# A greeting with a default or a randomly picked salutation (see README.md)
MACRO greeting = {
    TEXT = "salutation, name!";
    PARAMS = { salutation = Hello; };
    ARGS = { required name = ""; };
};
MACRO salutation_pick = { TEXT = "select(text=Hello Hi Howdy)"; };
